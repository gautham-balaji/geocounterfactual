# Copy to .env at the repo root and fill in. .env is gitignored.

# ---- Earth Engine ----
GEE_PROJECT_ID=geocounterfactual-backend
GEE_KEY_PATH=backend/secrets/gcf-backend.json

# ---- Planner LLM (Gemini) ----
# Without a key the Planner falls back to deterministic keyword parsing, so the
# pipeline still runs end to end.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Generator backend: stub | local | remote ----
# stub   : procedural, no torch. Used for graph wiring and CI.
# local  : CPU Stable Diffusion inpaint + ControlNet on this machine.
# remote : offload to a Colab T4 via the URL below (Compute Option A).
GENERATOR_BACKEND=stub
REMOTE_GENERATOR_URL=

# ---- Data engine ----
TARGET_SCALE_M=10
CLOUD_SCORE_THRESHOLD=0.60
MAX_CLOUDY_PIXEL_PCT=35
ALLOW_SYNTHETIC_FALLBACK=true

# ---- Critic ----
MAX_CRITIC_ITERATIONS=3
MAX_SLOPE_FOR_WATER_DEG=2.5
MAX_ANNUAL_NDVI_DELTA=0.35
MIN_OUTSIDE_SSIM=0.90
